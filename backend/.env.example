# Copy this file to .env for local development.
# On Render, set these as Environment Variables in the dashboard instead —
# do not upload a .env file there.

# Local MongoDB Compass connection (development only):
# MONGO_URI=mongodb://127.0.0.1:27017/portfolioDB

# MongoDB Atlas connection (used in production / on Render):
MONGO_URI=your_mongodb_atlas_connection_string

PORT=5000

# The URL of your deployed frontend (Render Static Site), used for CORS.
# Example: https://your-portfolio.onrender.com
FRONTEND_URL=
